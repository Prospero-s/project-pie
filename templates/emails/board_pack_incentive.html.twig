<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rappel urgent : Board Pack en attente pour {{ companyName }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; background-color: #f5f5f5; color: #313847; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    <!-- Table principale centrée -->
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto;">
        <tr>
            <td align="center" style="padding: 20px;">
                <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin: 0 auto;">
                    <!-- En-tête avec logo -->
                    <tr>
                        <td align="center" style="padding: 30px 30px 20px 30px; background-color: #ff4d4f; border-radius: 8px 8px 0 0;">
                            <img src="https://raw.githubusercontent.com/Prospero-s/project-pie/rebase-dev/assets/img/logo/logo-icon-prospero-white.png" alt="Prospero" width="180" style="display: block; margin: 0 auto; border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic;" />
                        </td>
                    </tr>
                    
                    <!-- Titre -->
                    <tr>
                        <td align="center" style="padding: 30px 30px 0 30px; color: #ff4d4f; font-size: 24px; font-weight: bold;">
                            🚨 Rappel urgent Board Pack
                        </td>
                    </tr>
                    
                    <!-- Contenu -->
                    <tr>
                        <td align="left" style="padding: 20px 30px;">
                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td style="padding: 10px 0; color: #313847; font-size: 16px; line-height: 24px;">
                                        Bonjour {{ userName }},
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 0; color: #313847; font-size: 16px; line-height: 24px;">
                                        Nous remarquons que le Board Pack de <strong>{{ companyName }}</strong> n'a pas encore été déposé, alors que d'autres entreprises de votre portefeuille ont déjà soumis leurs rapports.
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 15px; background-color: #fff1f0; border-radius: 4px; border-left: 4px solid #ff4d4f;">
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                            <tr>
                                                <td style="padding: 5px 0; color: #313847; font-size: 14px; font-weight: bold;">
                                                    🏢 Entreprise en attente :
                                                </td>
                                                <td style="padding: 5px 0; color: #313847; font-size: 14px;">
                                                    {{ companyName }}
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 5px 0; color: #313847; font-size: 14px; font-weight: bold;">
                                                    📊 Progression du portefeuille :
                                                </td>
                                                <td style="padding: 5px 0; color: #313847; font-size: 14px;">
                                                    {{ companiesUploaded }}/{{ totalCompanies }} entreprises ont déposé leur Board Pack
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                
                                <!-- Barre de progression visuelle -->
                                <tr>
                                    <td style="padding: 20px 0 10px 0;">
                                        <div style="background-color: #f0f0f0; border-radius: 10px; height: 20px; position: relative; overflow: hidden;">
                                            <div style="background-color: #52c41a; height: 100%; width: {{ (companiesUploaded / totalCompanies * 100)|round }}%; border-radius: 10px; position: relative;">
                                                <span style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px; font-weight: bold; color: white;">
                                                    {{ (companiesUploaded / totalCompanies * 100)|round }}%
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                
                                <tr>
                                    <td style="padding: 20px 0 10px 0; color: #313847; font-size: 16px; line-height: 24px;">
                                        <strong>Pourquoi est-ce important ?</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 0; color: #313847; font-size: 14px; line-height: 20px;">
                                        • 📊 <strong>Vue d'ensemble complète :</strong> Avoir tous les Board Packs permet une analyse comparative optimale
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 0; color: #313847; font-size: 14px; line-height: 20px;">
                                        • ⚡ <strong>Synchronisation :</strong> Les autres entreprises attendent pour une vision globale du portefeuille
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 0; color: #313847; font-size: 14px; line-height: 20px;">
                                        • 🎯 <strong>Décisions éclairées :</strong> Les analyses stratégiques nécessitent des données complètes
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 0; color: #313847; font-size: 16px; line-height: 24px;">
                                        Connectez-vous à votre tableau de bord Prospero pour déposer votre Board Pack dès maintenant.
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 15px; background-color: #e6f7ff; border-radius: 4px; border-left: 4px solid #1890ff;">
                                        <div style="color: #313847; font-size: 14px; line-height: 20px;">
                                            💡 <strong>Besoin d'aide ?</strong> Notre équipe support est disponible pour vous accompagner dans le processus de dépôt. N'hésitez pas à nous contacter !
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0 10px 0; color: #313847; font-size: 16px; line-height: 24px;">
                                        Merci pour votre collaboration et votre réactivité.
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 0; color: #313847; font-size: 16px; line-height: 24px;">
                                        Cordialement,<br />
                                        L'équipe Prospero
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Pied de page -->
                    <tr>
                        <td align="center" style="padding: 20px 30px; border-top: 1px solid #E2E7EA; background-color: #f8f9fa; border-radius: 0 0 8px 8px; text-align: center; color: #666666; font-size: 14px;">
                            &copy; {{ "now"|date("Y") }} Prospero. Tous droits réservés.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html> 