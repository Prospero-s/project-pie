<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}PROSPERO{% endblock %}</title>
        <link rel="icon" href="{{ asset('logo-icon-prospero-blue.svg') }}" type="image/svg+xml">
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
            <script>
                (function (m, a, z, e) {
                var s, t;
                try {
                    t = m.sessionStorage.getItem('maze-us');
                } catch (err) {}

                if (!t) {
                    t = new Date().getTime();
                    try {
                    m.sessionStorage.setItem('maze-us', t);
                    } catch (err) {}
                }

                s = a.createElement('script');
                s.src = z + '?apiKey=' + e;
                s.async = true;
                a.getElementsByTagName('head')[0].appendChild(s);
                m.mazeUniversalSnippetApiKey = e;
                })(window, document, 'https://snippet.maze.co/maze-universal-loader.js', '3bf0d7ad-b15c-4647-a6a3-abfcee631d8e');
            </script>
        {% endblock %}
    </head>
    <body class="font-sans">
        {% block body %}
        {% endblock %}
    </body>
</html>