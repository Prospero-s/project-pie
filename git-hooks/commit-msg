#!/usr/bin/env bash

# Vérifier que bash est bien utilisé (plus portable)
if [ -z "$BASH" ]; then
    echo "❌ Ce script doit être exécuté avec bash."
    exit 1
fi

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Format regex compatible avec macOS - utilise les classes POSIX pour supporter l'Unicode
commit_regex='^(feat|fix|docs|style|refactor|test|chore)(\([a-zA-Z0-9,_.\-\+\(\)[:space:][:alpha:]]+\))?: .*$'

if ! echo "$commit_msg" | grep -E "$commit_regex" > /dev/null 2>&1; then
    echo "--------------------------------"
    echo "❌ Le format du message de commit est invalide."
    echo "Format attendu: <type>(<scope>): <description>"
    echo "Types autorisés: feat, fix, docs, style, refactor, test, chore"
    echo "👀 Exemple avec accents: fix(données): résolution du problème d'encodage des caractères spéciaux"
    echo "--------------------------------"
    exit 1
fi

echo "--------------------------------"
echo "✅ Le format du message de commit est valide"
echo "--------------------------------"
exit 0 