#!/bin/bash

# Vérifier que bash est bien utilisé
if [ -z "$BASH_VERSION" ]; then
    echo "❌ Ce script doit être exécuté avec bash."
    exit 1
fi

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Format regex
commit_regex='^(feat|fix|docs|style|refactor|test|chore)(\([a-zA-Z0-9-]+\))?: .{1,150}$'

if ! [[ "$commit_msg" =~ $commit_regex ]]; then
    echo "--------------------------------"
    echo "❌ Le format du message de commit est invalide."
    echo "Format attendu: <type>(<scope>): <description>"
    echo "Types autorisés: feat, fix, docs, style, refactor, test, chore"
    echo "👀 Exemple: feat(auth): ajout de la fonctionnalité de login"
    echo "--------------------------------"
    exit 1
fi

echo "--------------------------------"
echo "✅ Format du message de commit validé"
echo "--------------------------------"
exit 0 