# .git/hooks/pre-push
#!/usr/bin/env bash

# Regex pour les noms de branches
branch_regex='^(feat|fix|docs|style|refactor|test|chore)/PROS-[0-9]+(-[a-z0-9]+)+$'

z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = $z40 ]; then
        # Handle delete
        continue
    fi

    if [ "$remote_sha" = $z40 ]; then
        # New branch
        branch_name=${remote_ref#refs/heads/}
    else
        # Update to existing branch
        branch_name=${remote_ref#refs/heads/}
    fi

    if [ -n "$branch_name" ]; then
        if ! echo "$branch_name" | grep -Eq "$branch_regex"; then
            echo "--------------------------------"
            echo "❌ Le format du nom de la branche '$branch_name' est invalide."
            echo "Format attendu: <type>/PROS-<ticket-id>-<description>"
            echo "Types autorisés: feat, fix, docs, style, refactor, test, chore"
            echo "👀 Exemple: feat/PROS-123-ajout-de-la-fonctionnalite-de-login"
            echo "--------------------------------"
            exit 1
        fi
    fi
done

echo "--------------------------------"
echo "✅ Format des noms de branches validé pour tous les éléments poussés"
echo "--------------------------------"
exit 0